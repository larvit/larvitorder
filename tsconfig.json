{
	"compileOnSave": true,
	"compilerOptions": {
		"allowJs": false,
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		// uuid 12+ is ESM-only. nodenext allows CJS to require() it, which Node 22 does. node16 raises TS1479.
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"types": ["node"],
		"preserveSymlinks": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2020"
	},
	"include": [
		"src/**/*.ts"
	]
}
