{
	"compileOnSave": true,
	"compilerOptions": {
		"allowJs": false,
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		// Package stays CommonJS. uuid is pinned to 11.x so tsc emits require("uuid"); uuid 12+ is ESM-only.
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"types": ["node"],
		"preserveSymlinks": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2020"
	},
	"include": [
		"src/**/*.ts"
	]
}
