{
	"compileOnSave": true,
	"compilerOptions": {
		"allowJs": false,
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"module": "node16",
		"moduleResolution": "node16",
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"types": ["node"],
		"preserveSymlinks": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2020"
	},
	"include": [
		"src/**/*.ts"
	]
}
