{
  "name": "larvitorder",
  "version": "4.1.15",
  "description": "Generic order system",
  "main": "./dist/index.js",
  "files": [
    "/dist",
    "/dbmigration"
  ],
  "dependencies": {
    "async": "3.2.6",
    "larvitdb": "3.2.157",
    "larvitdbmigration": "7.0.220",
    "larvitutils": "5.1.211",
    "luxon": "^3.1.1",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@istanbuljs/nyc-config-typescript": "1.0.2",
    "@stylistic/eslint-plugin": "3.1.0",
    "@types/luxon": "^3.1.0",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.0",
    "@types/uuid": "11.0.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "mocha": "12.0.2",
    "nyc": "18.0.0",
    "ts-node": "10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "scripts": {
    "build": "rm -rf dist/* && tsc",
    "lint": "eslint src/*.ts test/*.ts",
    "test:unit": "TS_NODE_PROJECT=./test/tsconfig.json mocha --exit --bail -r ts-node/register 'test/**/*.ts'",
    "test:cov": "TS_NODE_PROJECT=./test/tsconfig.json nyc mocha --exit --bail -r ts-node/register 'test/**/*.ts'",
    "test": "npm run lint && npm run test:cov"
  },
  "repository": "https://github.com/larvit/larvitorder.git",
  "keywords": [
    "order",
    "orders",
    "multi-purpose"
